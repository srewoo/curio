{
  "name": "curio",
  "version": "1.1",
  "private": true,
  "type": "module",
  "description": "Curio — a private, grounded, age-appropriate AI chapter tutor (Chrome MV3 extension).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/fix-underscore.mjs && node scripts/zip.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@types/katex": "^0.16.8",
    "@xenova/transformers": "^2.17.2",
    "dompurify": "^3.4.12",
    "katex": "^0.17.0",
    "mammoth": "^1.8.0",
    "marked": "^18.0.6",
    "mathjs": "^15.2.0",
    "mermaid": "^11.16.0",
    "pdfjs-dist": "^4.5.136",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.270",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vite-plugin-web-extension": "^4.1.1",
    "vitest": "^2.0.5"
  }
}